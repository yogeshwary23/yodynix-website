{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yodynix-contact",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // Non-secret settings. SMTP_PASSWORD is a secret: set it with
  //   npx wrangler secret put SMTP_PASSWORD
  // Never add it here.
  "vars": {
    "SMTP_HOST": "mail.spacemail.com",
    "SMTP_PORT": "465",
    "SMTP_USERNAME": "hr@yodynix.it.com",
    "CONTACT_RECEIVER_EMAIL": "hr@yodynix.it.com",
    // Exact origins allowed to call the API (comma-separated, no trailing slash).
    // Add your *.pages.dev URL here if the site is also served from it.
    "ALLOWED_ORIGINS": "https://yodynix.it.com,https://www.yodynix.it.com,http://localhost:8080"
  },

  // 5 enquiries per minute per visitor IP.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
